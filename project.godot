; Engine configuration file.
; Godot 4.x — milk-tea-kingdom idle MVP scaffold
config_version=5

[application]

config/name="奶茶王国放置"
config/description="Idle / 放置 MVP：计时、离线、JSON 存档、表驱动升级"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

FlightDeckProbe="*res://addons/flight_deck/runtime_probe.gd"
GameState="*res://scripts/game_state.gd"

[display]

window/handheld/orientation=1
window/size/viewport_width=720
window/size/viewport_height=1280
; Stretch stays off in the project file. main.gd enables canvas_items/expand
; only for portrait windows that can scale the 720 design UP (phone widths
; ≥1170). A static expand mode downscales short windows and shrinks ≥56 hotzones.
window/stretch/mode=""

[rendering]

renderer/rendering_method="gl_compatibility"
; Web ships one pck. Do not import S3TC and ETC2/ASTC variants (they would both download).
textures/vram_compression/import_s3tc_bptc=false
textures/vram_compression/import_etc2_astc=false

[editor_plugins]

enabled=PackedStringArray("res://addons/flight_deck/plugin.cfg")
